@article{Manchester:2014aa,
	abstract = {In this paper we introduce the concept of universal stabilizability: the condition that every solution of a nonlinear system can be globally stabilized. We give sufficient conditions in terms of the existence of a control contraction metric, which can be found by solving a pointwise linear matrix inequality. Extensions to approximate optimal control are straightforward. The conditions we give are necessary and sufficient for linear systems and certain classes of nonlinear systems, and have interesting connections to the theory of control Lyapunov functions.},
	author = {Ian R. Manchester and Jean-Jacques E. Slotine},
	date-added = {2025-12-06 08:12:03 +0900},
	date-modified = {2025-12-06 08:12:04 +0900},
	doi = {https://doi.org/10.3182/20140824-6-ZA-1003.02100},
	issn = {1474-6670},
	journal = {IFAC Proceedings Volumes},
	note = {19th IFAC World Congress},
	number = {3},
	pages = {8223-8228},
	title = {Control Contraction Metrics and Universal Stabilizability},
	volume = {47},
	year = {2014},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S1474667016429101},
	bdsk-url-2 = {https://doi.org/10.3182/20140824-6-ZA-1003.02100}}

@article{Andrieu:2019aa,
	abstract = {This paper deals with a systematic way to check if a certain class of nonlinear systems can define a contraction. The proposed approach combines the use of sector bound condition or monotonic condition satisfied by the nonlinearities with the use of an adequate control function matrix. The contraction analysis results are provided under the form of linear matrix inequalities (LMIs). The design of a nonlinear control law (that is a control law depending on nonlinearities) is proposed in order for the closed loop to be a contraction. The adaptation of the contraction results to the synchronization of n identical nonlinear systems is also investigated by considering two kinds of communication graphs (full and general undirected ones).},
	author = {V. Andrieu and S. Tarbouriech},
	date-added = {2025-12-06 08:07:07 +0900},
	date-modified = {2025-12-06 08:07:38 +0900},
	doi = {https://doi.org/10.1016/j.ifacol.2019.12.030},
	issn = {2405-8963},
	journal = {IFAC-PapersOnLine},
	keywords = {Contraction, nonlinear systems, synchronization, LMIs},
	note = {11th IFAC Symposium on Nonlinear Control Systems NOLCOS 2019},
	number = {16},
	pages = {616-621},
	title = {LMI conditions for contraction and synchronization ⁎⁎Research funded in part by ANR via project HANDY, number ANR-18-CE40-0010.},
	volume = {52},
	year = {2019},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S2405896319318580},
	bdsk-url-2 = {https://doi.org/10.1016/j.ifacol.2019.12.030}}


@book{Boyd:2004aa,
  abstract = {{Convex optimization problems arise frequently in many different fields. A comprehensive introduction to the subject, this book shows in detail how such problems can be solved numerically with great efficiency. The focus is on recognizing convex optimization problems and then finding the most appropriate technique for solving them. The text contains many worked examples and homework exercises and will appeal to students, researchers and practitioners in fields such as engineering, computer science, mathematics, statistics, finance, and economics.}},
